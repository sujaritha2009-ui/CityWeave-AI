# CityWeave AI Environment Configuration

# Public Google Maps Key (used on frontend for Maps JS API, TrafficLayer, and Places)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL (defaults to http://localhost:4000 or proxied via Vite /api)
VITE_API_URL=

# Google Gemini API Key (kept secure on backend server, never exposed in client bundle)
GEMINI_API_KEY=
